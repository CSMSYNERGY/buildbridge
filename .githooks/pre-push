#!/bin/sh
# Pre-push gate. Wire it up once per clone:
#   git config core.hooksPath .githooks
#   npm ci
#
# Two checks, in order:
#   1. FRESHNESS  — refuse to push a branch that is behind its remote. THE RULE
#      (2026-08-02): always `git pull --rebase origin <branch>` before pushing.
#   2. CORRECTNESS — repo-specific; see the section at the bottom of this file.
# Zero output means go. Emergency bypass: git push --no-verify — say so in the commit.
cd "$(git rev-parse --show-toplevel)" || exit 1

# $1 is the remote's name as given on the command line ("origin"), $2 its URL. Pushing to
# a bare URL leaves $1 as that URL, which still reads correctly in the messages below.
remote_name=${1:-origin}

# ── 1. Freshness ─────────────────────────────────────────────────────────────
# WHY THIS IS A GATE AND NOT ADVICE: several Claude sessions plus a human share these
# clones and these branches. On 2026-08-02 eight commits landed on a shared branch while
# one session was mid-feature; the push bounced, and the recovery (stash, rebase, re-verify
# every change) is exactly the kind of manual scramble where work gets clobbered. Rebasing
# FIRST also means the correctness checks below run against the code as it will really
# exist on the remote, not as it existed in isolation.
#
# The hook deliberately does NOT run the pull for you: a rebase rewrites the working tree,
# and a hook that does that mid-push is a nasty surprise the first time it hits a conflict.
# It names the one command; you run it knowingly.
#
# ── HOW IT KNOWS (ported from StructureStudio 2026-08-05, and why the old way was inert) ──
# Git feeds this hook one line per ref being pushed:
#     <local-ref> <local-oid> <remote-ref> <remote-oid>
# <remote-oid> is that ref's CURRENT value ON THE REMOTE, learned during ref discovery,
# which git completes BEFORE running this hook. The freshness answer is therefore already
# in our hands: no fetch of our own, no guessing at names, nothing that can time out.
#
# The first version of this hook instead ran `git fetch origin "$(git rev-parse --abbrev-ref HEAD)"`
# and that was wrong twice over:
#   * It probed the LOCAL branch name. `git push origin HEAD:main` — how every worktree
#     session pushes — made it look for a branch named after the local topic branch, which
#     does not exist on origin at all. Pushing any branch under a different remote name had
#     the same problem.
#   * A missing remote ref makes fetch exit 128, and the hook reported that as
#     "could not reach origin — skipping the freshness check" and then PASSED. So for that
#     push style the gate was silently inert: it announced a network fault that did not
#     exist and waved the push through.
# Note there is no fail-open case left to handle, because a genuinely unreachable origin
# cannot reach this code: the push dies at ref discovery, before any hook runs. That branch
# was only ever reporting a false alarm.
#
# A deliberate rewind (force-push) also lands in "you are behind", since git tells the hook
# nothing about --force. That is the intended reading on a shared branch; use --no-verify
# when you really mean to rewrite what is on the remote.

# All-zeros oid = "this side does not exist". Written as a glob rather than a compare
# against 40 zeros so it holds for sha256 repositories too.
all_zero() {
  case "$1" in
    "" | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

stale=0
# `|| [ -n "$local_ref" ]` so a final line with no trailing newline is still processed.
# No pipeline here on purpose: a `while` fed by a pipe runs in a subshell in POSIX sh and
# $stale would not survive the loop.
while read -r local_ref local_oid remote_ref remote_oid || [ -n "$local_ref" ]; do
  # Branches only. A tag or a note has no meaningful "behind" to block on.
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  all_zero "$local_oid"  && continue   # deleting the remote ref
  all_zero "$remote_oid" && continue   # brand-new branch: nothing to be behind

  short=${remote_ref#refs/heads/}
  behind=""

  if git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    # The remote tip is already contained in what we are pushing → fast-forward → current.
    git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null && continue
    behind=$(git rev-list --count "$local_oid..$remote_oid" 2>/dev/null)
  else
    # We do not even have the remote's tip object, so we are certainly missing its work —
    # the verdict is already decided. This fetch runs ONLY to put a number in the message,
    # and the low-speed bounds keep a sick network from hanging an already-failing push.
    # Kept on ONE line deliberately: a trailing-backslash continuation breaks outright if
    # this file is ever checked out with CRLF, because the backslash escapes the CR instead
    # of the newline (git then gets a literal "r" argument and the next line runs on its
    # own). .gitattributes pins this file to LF, and this keeps it safe even if that slips.
    if git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch --quiet "$remote_name" "$short" 2>/dev/null; then
      behind=$(git rev-list --count "$local_oid..$remote_oid" 2>/dev/null)
    fi
  fi

  if [ -n "$behind" ] && [ "$behind" != "0" ]; then
    echo "pre-push: refused — $remote_name/$short has $behind commit(s) you do not have." >&2
  else
    echo "pre-push: refused — $remote_name/$short has commits you do not have." >&2
  fi
  echo "" >&2
  echo "  git pull --rebase $remote_name $short" >&2
  echo "" >&2
  echo "Then push again. (Rebase first so your work lands on top of theirs, and so the" >&2
  echo "checks below run against what is really on the remote. Bypass: --no-verify.)" >&2
  stale=1
done

[ "$stale" -eq 0 ] || exit 1

# ── 2. Correctness ───────────────────────────────────────────────────────────
# Wired 2026-08-05. Every lint / test / typecheck command in this repo was audited against
# four properties first, because a bad gate is worse than none:
#   * non-vacuous     — it actually inspects real code. A lint matching zero files, or a
#                       tsconfig with "files": [], exits 0 forever and manufactures false
#                       confidence. Both of those were found and rejected during the audit.
#   * catches defects — proven by planting a real one and watching the check go red.
#   * hermetic        — no network, no database, no secrets. A flaky gate is how everyone
#                       learns to type --no-verify, which costs you both gates at once.
#   * fast            — this runs on every push. The whole section is ~10-15s.
#
# ⚠ These checks read the WORKING TREE, not the commits being pushed — the same property
# StructureStudio's preflight has. In a checkout shared with other sessions, someone
# else's stray file can fail your push. Read the paths in the output before assuming the
# problem is yours.

# check <label> <command…> — silent on success; on failure prints the tool's own output,
# names the gate, and stops the push.
check() {
  label=$1
  shift
  if ! out=$("$@" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "" >&2
    echo "pre-push: $label failed (output above). Fix it, or bypass: git push --no-verify" >&2
    exit 1
  fi
}

if [ ! -f ./node_modules/.bin/vitest ]; then
  echo "pre-push: the correctness gate needs this repo's dev tools — run: npm ci" >&2
  exit 1
fi
if [ ! -f frontend/node_modules/.bin/vite ]; then
  echo "pre-push: the frontend build gate needs its deps — run: npm --prefix frontend ci" >&2
  exit 1
fi

# 156 unit tests across src/services/qbSyncLogic.test.js and issueClassifier.test.js —
# logic that quickbooksController, qbSyncService and quickbooksService all import. Pure
# units: no network, no D1, no wrangler, no env vars. (The classifier half also reads src/
# from disk to enumerate error kinds; still hermetic, still no network.)
check "unit tests" npm test

# Syntax-check every other JS file. Blunt, but this repo has NO eslint config and NO
# TypeScript anywhere (verified: zero tracked eslint.config.*, .eslintrc*, tsconfig*), so
# without this line nothing at all parses the other ~50 Worker modules or monitor/worker.js
# before they deploy. 58 files in ~2s, run four at a time.
check "syntax (node --check)" sh -c 'git ls-files -- src monitor scripts | grep -E "\.(js|mjs|cjs)$" | xargs -r -n1 -P4 node --check'

# The frontend build resolves its import graph — 1627 modules, all 20 first-party files
# confirmed in the bundle. This catches the unresolvable-import / syntax-error class that
# produced the 2026-07-20 blank page.
# The output path is deliberate on both counts: NOT the real dist/ (--emptyOutDir would
# wipe a deploy artifact) and NOT `mktemp -d` (that leaks a fresh directory on every push).
check "frontend build" sh -c '( cd frontend && ./node_modules/.bin/vite build --outDir "${TMPDIR:-/tmp}/bb-pre-push-build" --emptyOutDir >/dev/null )'

# …but a build never EVALUATES a component, and that blind spot shipped a page that failed on
# 100% of loads. 2026-08-04: QuickBooks.jsx read `s` on line 649 while `const s` was declared
# on line 802, so every render threw `Cannot access 's' before initialization` — and the build
# above stayed green for a day, because every import still resolved fine.
#
# So: server-render every page under frontend/src/pages/ and require it not to throw. SSR runs
# the render body and skips effects, which is precisely where that class of bug lives and
# precisely what needs no browser, no backend and no fixtures. Pages are discovered, not
# listed — the sibling lesson from the error-classifier guard, which named 6 of 23 kinds and
# was uselessly green for weeks. ~3s.
#
# Proven non-vacuous the way this section demands: restoring the real pre-fix QuickBooks.jsx
# makes it exit 1 and name the binding. It is a FLOOR, not a substitute for testing behaviour —
# anything that only happens after mount is invisible to it.
check "frontend pages render" sh -c '( cd frontend && node scripts/smoke-render.mjs >/dev/null )'

# Deliberately NOT `npm run verify:deploy`: it fetches the LIVE deployed site to catch the
# blank-page outage, so it asserts against production rather than against your working
# tree. As a PRE-push gate it would pass while you push a broken change, and fail while
# you push a fix. It belongs after a deploy, which is where `npm run deploy` already puts
# it. And NOT `npm run test:watch` — bare vitest never exits and would hang the push.
